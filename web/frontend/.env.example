# Where the reduction worker lives. The browser never sees this — the
# UI calls its own /api/* routes and those forward here server-side.
#
# Local development: start the worker with
#   cd web/worker && uvicorn main:app --port 8000
WORKER_URL=http://127.0.0.1:8000

# Deployed: set this in the Vercel project's environment variables to
# your worker's public URL, e.g.
# WORKER_URL=https://automre-worker.fly.dev
